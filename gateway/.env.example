# 腾讯云语音识别控制台 / 访问管理中的 AppID
TENCENT_APPID=1250000000

# 访问管理 -> API 密钥管理中的 SecretId / SecretKey
TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 实时语音识别引擎，普通话 16k 场景默认 16k_zh
TENCENT_ENGINE_MODEL=16k_zh

# 网关监听地址；只在本机使用时保持 127.0.0.1
ASR_GATEWAY_HOST=127.0.0.1
ASR_GATEWAY_PORT=8765

# 可选：本地 FunASR 的 Python 环境和模型缓存目录
# FUNASR_PYTHON=C:\Path\to\python.exe
# FUNASR_CACHE_DIR=C:\Path\to\funasr-cache
